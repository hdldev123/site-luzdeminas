# Copie este arquivo para .env.local e preencha com os valores reais.
# O .env.local NAO vai para o git.

# Formspree — destino das inscricoes do formulario "Inscreva-se".
# Pegue o endpoint em https://formspree.io (Forms > seu form > Integration).
# Aceita a URL completa ou apenas o ID do formulario:
#   FORMSPREE_ENDPOINT="https://formspree.io/f/abcdwxyz"
#   FORMSPREE_ENDPOINT="abcdwxyz"
# Sem esta variavel, os e-mails caem no fallback local: data/inscricoes.csv
FORMSPREE_ENDPOINT=""

# Formspree — destino dos cadastros do modal "Seja um parceiro" (Guia Local).
# Use um formulario DIFERENTE do de inscricao, para nao misturar os leads.
# Sem esta variavel, os cadastros caem no fallback local: data/parceiros.csv
FORMSPREE_PARCEIRO_ENDPOINT=""
